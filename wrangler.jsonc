{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agentic-stable",
  "account_id": "800c4ef344ae29a93b1588a10962b72c",
  "main": "agent-wallet/deployment/worker.ts",
  "compatibility_date": "2026-10-14",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./agent-wallet/app/dist", "binding": "ASSETS" },
  // Retain the existing namespace and data. The wallet does not use this binding.
  "durable_objects": {
    "bindings": [{ "name": "FUNDING_LEDGER", "class_name": "FundingLedger" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FundingLedger"] }],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
