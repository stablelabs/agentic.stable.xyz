# PRIVATE server values. Never prefix these with VITE_.
PORT=8787
PUBLIC_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/site.sqlite
PAYMENTS_ENABLED=false
STABLE_RPC_URL=https://rpc.testnet.stable.xyz
# Generate with: openssl rand -hex 32
SESSION_ENCRYPTION_KEY=
# Dedicated, capped TESTNET wallet only. Never reuse a production key.
FUNDING_PRIVATE_KEY=
SELLER_ADDRESS=
SESSION_FUND_USDT0=1
SESSION_BUDGET_USDT0=0.05
PRICE_USDT0=0.01
MAX_FEE_USDT0=0.01
GLOBAL_FUNDING_CAP_USDT0=10
SESSION_RATE_PER_HOUR=3
# Repository access currently requires organization permission.
REPOSITORY_URL=https://github.com/stablelabs/agentic.stable.xyz
# Standalone seller runs independently with its own database.
SELLER_PORT=8788
SELLER_DATABASE_PATH=./data/seller.sqlite
# Standalone buyer: a different local testnet signer, never the browser's wallet.
BUYER_PRIVATE_KEY=
SELLER_URL=http://localhost:8788
BUYER_BUDGET_USDT0=0.05
