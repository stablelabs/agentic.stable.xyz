{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "src",
    "scripts",
    "vite.config.ts",
    "playwright.config.ts"
  ],
  "exclude": [
    "dist",
    "deployment",
    "tests"
  ]
}
