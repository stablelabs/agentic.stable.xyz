{
  "name": "@stablechain/agent-wallet-cli",
  "version": "0.1.1",
  "type": "module",
  "bin": {
    "agent-wallet": "./dist/main.js"
  },
  "exports": {
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "import": "./dist/agent/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@stablechain/agent-wallet-sdk": "0.1.1",
    "viem": "^2.38.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/executable.mjs",
    "wallet": "node dist/main.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "prepack": "npm run build"
  },
  "description": "Agent signer, grant discovery, bounded payments, and recovery for Agent Wallet on Stable Testnet.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stablelabs/agentic.stable.xyz.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/stablelabs/agentic.stable.xyz/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/stablelabs/agentic.stable.xyz/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "stablechain",
    "agent-wallet",
    "eip-7702",
    "payments",
    "testnet",
    "cli"
  ]
}
