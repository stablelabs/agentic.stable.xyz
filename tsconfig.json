{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "packages/*/tests/**/*.ts",
    "packages/web/deployment/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/dist",
    "packages/contracts/out",
    "packages/contracts/cache"
  ]
}
