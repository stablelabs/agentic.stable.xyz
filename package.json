{
  "name": "agent-wallet-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "wallet": "node packages/cli/dist/main.js",
    "build:tools": "npm run build:sdk && npm run build:cli",
    "dev": "npm run build:sdk && npm run dev --workspace agent-wallet-web",
    "build": "npm run build --workspaces",
    "preview": "npm run preview --workspace agent-wallet-web",
    "check": "npm run build:tools && tsc --noEmit && npm run check --workspaces",
    "contracts": "npm run build --workspace agent-wallet-contracts",
    "pretest": "npm run contracts && npm run build:tools",
    "test": "vitest run --config vitest.config.ts",
    "test:contracts": "npm run test --workspace agent-wallet-contracts",
    "test:browser": "npm run build:sdk && npm run test --workspace agent-wallet-web",
    "wallet:contracts": "npm run contracts",
    "wallet:enable": "node --import tsx scripts/enable-account.ts",
    "wallet:init-agent": "node --import tsx scripts/init-agent.ts",
    "wallet:request": "node --import tsx scripts/request-grant.ts",
    "wallet:grant-link": "node --import tsx scripts/grant-link.ts",
    "wallet:pay": "node --import tsx scripts/pay.ts",
    "wallet:dev": "npm run dev",
    "wallet:build": "npm run build",
    "wallet:test:contracts": "npm run test:contracts",
    "wallet:test": "npm test",
    "wallet:test:browser": "npm run test:browser",
    "wallet:live": "node --import tsx scripts/live-acceptance.ts",
    "build:cloudflare": "npm run cloudflare:types && npm run build:web",
    "cloudflare:types": "wrangler types packages/web/deployment/env.d.ts",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy",
    "prebuild": "npm run cloudflare:types",
    "precheck": "npm run cloudflare:types",
    "build:sdk": "npm run build --workspace @stablechain/agent-wallet-sdk",
    "build:cli": "npm run build --workspace @stablechain/agent-wallet-cli",
    "build:web": "npm run build:sdk && npm run build --workspace agent-wallet-web",
    "dev:sdk": "npm run dev --workspace @stablechain/agent-wallet-sdk",
    "prewallet:enable": "npm run build:tools",
    "prewallet:init-agent": "npm run build:tools",
    "prewallet:grant-link": "npm run build:tools",
    "prewallet:pay": "npm run build:tools",
    "prewallet:live": "npm run build:tools",
    "build:contracts": "npm run contracts",
    "release:check": "node --import tsx scripts/release.ts check",
    "release:publish": "node --import tsx scripts/release.ts publish"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.151.0",
    "viem": "^2.38.0",
    "dotenv": "^16.5.0"
  },
  "workspaces": [
    "packages/sdk",
    "packages/cli",
    "packages/web",
    "packages/contracts"
  ]
}
