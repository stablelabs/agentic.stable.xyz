{
  "name": "agent-wallet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite --config agent-wallet/vite.config.ts",
    "build": "tsc --noEmit && vite build --config agent-wallet/vite.config.ts && node --import tsx agent-wallet/scripts/prepare-cloudflare.ts",
    "preview": "vite preview --config agent-wallet/vite.config.ts",
    "check": "tsc --noEmit",
    "contracts": "node --import tsx agent-wallet/scripts/build-contracts.ts",
    "pretest": "npm run contracts",
    "test": "vitest run --config agent-wallet/vitest.config.ts",
    "test:contracts": "node --import tsx agent-wallet/scripts/build-contracts.ts test",
    "test:browser": "playwright test --config agent-wallet/playwright.config.ts",
    "wallet:contracts": "npm run contracts",
    "wallet:enable": "node --import tsx agent-wallet/scripts/enable-account.ts",
    "wallet:init-agent": "node --import tsx agent-wallet/scripts/init-agent.ts",
    "wallet:request": "node --import tsx agent-wallet/scripts/request-grant.ts",
    "wallet:grant-link": "node --import tsx agent-wallet/scripts/grant-link.ts",
    "wallet:pay": "node --import tsx agent-wallet/scripts/pay.ts",
    "wallet:dev": "npm run dev",
    "wallet:build": "npm run build",
    "wallet:test:contracts": "npm run test:contracts",
    "wallet:test": "npm test",
    "wallet:test:browser": "npm run test:browser",
    "wallet:live": "node --import tsx agent-wallet/scripts/live-acceptance.ts",
    "build:cloudflare": "npm run build",
    "cloudflare:types": "wrangler types agent-wallet/deployment/env.d.ts",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy",
    "prebuild": "npm run cloudflare:types",
    "precheck": "npm run cloudflare:types"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "^2.38.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.151.0"
  }
}
