{
  "name": "agentic-stable-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "predev": "node --import tsx scripts/build-docs.ts",
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && node --import tsx scripts/build-docs.ts && vite build && node --import tsx scripts/prerender.tsx",
    "start": "node --import tsx server/index.ts",
    "seller": "node --import tsx examples/paid-service/index.ts",
    "buyer": "node --import tsx examples/agent-buyer/index.ts",
    "check:network": "node --import tsx scripts/check-network.ts",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:live": "node --import tsx scripts/live-smoke.ts",
    "test:live:browser": "node --import tsx scripts/live-browser.ts"
  },
  "dependencies": {
    "@stablechain/sdk": "1.0.8",
    "better-sqlite3": "^11.10.0",
    "compression": "^1.8.2",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "marked": "^15.0.12",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "^2.38.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.51.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
}
